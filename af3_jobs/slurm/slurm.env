# Site settings for the Slurm AF3 scripts in this folder. Both schedulers
# source this file with `set -a` and submit with `--export=ALL`, so the workers see
# the same values. Edit it for another cluster; the #SBATCH headers in the two
# workers (partition, QOS, GPU type, log folder) are the cluster's too.

# Shared filesystem the compute nodes see. Inputs and outputs must live under it.
SHARED_ROOT=/rg
# Lab project space; per-user scheduler state and default outputs go under
# $PROJECT_ROOT/$USER.
PROJECT_ROOT=/rg/<lab_project>
# AF3 install: the container image plus models/ and databases/. It is bound into
# the container as /notroot (gen) or mounted there by the site (msa).
AF3_ROOT=/path/to/alphafold3
AF3_CONTAINER=$AF3_ROOT/alphafold3_latest.sif

# Paths inside the container
AF3_PYTHON=/app/alphafold/run_alphafold.py
MODEL_DIR=/notroot/models
DB_DIR=/notroot/databases
