# af3_local.env - per-server settings for msa_local.sh / gen_local.sh.
# Sourced by both stages. Every value can also be overridden from the
# environment for a single run, e.g.  MSA_N_CPU=4 ./msa_local.sh start X

# Edit the paths below for your machine.
#
# Everything this runner writes (inputs, MSAs, structures, state, temp files)
# lives under here. Keep it off the root disk: outputs run to hundreds of GB.
: "${AF3_WORK_ROOT:=$HOME/af3_runs}"

# Container and what is inside it. Every batch should come from one AF3 build,
# so a start refuses a container whose alphafold3 is not AF3_EXPECT_VERSION
# (empty disables the check). The cohort was generated with AlphaFold 3.0.1;
# do not mix in another build.
: "${AF3_SIF:=$HOME/alphafold3_3.0.1.sif}"
: "${AF3_EXPECT_VERSION:=3.0.1}"
: "${AF3_PY:=/app/alphafold/run_alphafold.py}"
: "${APPTAINER_BIN:=$(command -v singularity || command -v apptainer || echo singularity)}"

# Host paths. They are bound into the container at the same path.
: "${AF3_MODEL_DIR:=$HOME/alphafold3/models}"     # holds af3.bin (or af3.bin.zst)
: "${AF3_DB_DIR:=$HOME/alphafold3/databases}"     # the AF3 genetic databases

# Extra host directories to bind (space separated), e.g. input JSONs that live
# outside AF3_WORK_ROOT. Paths under $HOME are bound by Apptainer already.
: "${AF3_EXTRA_BINDS:=}"

# ---- MSA stage (CPU only) -------------------------------------------------
# A variant runs several hmmer searches at once (one per database), each with
# MSA_N_CPU threads, so one worker peaks near 4-5 x MSA_N_CPU cores.
: "${MSA_WORKERS:=4}"
: "${MSA_N_CPU:=2}"
: "${MSA_NICE:=10}"            # this is a shared machine: stay out of people's way

# ---- Generation stage (GPU) ----------------------------------------------
# One worker per entry. Indices are nvidia-smi indices (CUDA_DEVICE_ORDER is
# forced to PCI_BUS_ID so they agree). Repeat an index to run two jobs on one
# GPU, and lower GEN_XLA_MEM_FRACTION to match. golgi has four A40s (46 GB);
# pass a shorter list to `start` to leave some for other people.
: "${GEN_GPUS:=0,1,2,3}"
# AF3's recommended setting for a GPU you have to yourself is preallocate=true
# with a 0.95 fraction. On a GPU someone else is also using, set
# GEN_XLA_PREALLOCATE=false so JAX grows into what it needs instead.
: "${GEN_XLA_PREALLOCATE:=true}"
: "${GEN_XLA_MEM_FRACTION:=0.95}"
# Pre-Ampere GPUs (V100, T4, ...) need "xla" here; empty keeps AF3's default.
: "${GEN_FLASH_ATTN:=}"
: "${GEN_ARCHIVE:=1}"          # tar.gz each finished variant and delete its directory
: "${GEN_REQUIRE_MSA_SUCCESS:=1}"  # only take *_data.json whose MSA run wrote _SUCCESS

# ---- Both stages -----------------------------------------------------------
: "${MAX_ATTEMPTS:=2}"         # a variant that fails this many times is left alone
: "${MAX_CONSEC_FAIL:=3}"      # a worker that fails this many in a row stops (bad GPU, missing DB, ...)
: "${MIN_FREE_GB:=100}"        # a worker will not start a variant below this much free space
: "${POLL_SECS:=60}"           # gen: how often to look for new MSAs while the MSA stage is running
